diff --git a/system/main/shim/hci_layer.cc b/system/main/shim/hci_layer.cc
index e14e106efa..b76d84a23f 100644
--- a/system/main/shim/hci_layer.cc
+++ b/system/main/shim/hci_layer.cc
@@ -174,7 +174,24 @@ static void vendor_specific_event_callback(
 
 void OnTransmitPacketCommandComplete(command_complete_cb complete_callback,
                                      void* context,
+                                     bluetooth::hci::OpCode op_code,
                                      bluetooth::hci::CommandCompleteView view) {
+  if (!view.IsValid()) {
+    // hermes: when a controller rejects a vendor command with UNKNOWN_HCI_COMMAND, the HCI layer passes an empty view here.
+    // Reading it aborts the stack (was_validated_), so give the caller a Command Complete carrying that status instead.
+    LOG_WARN("%s is not supported by the controller",
+             bluetooth::hci::OpCodeText(op_code).c_str());
+    const uint16_t code = static_cast<uint16_t>(op_code);
+    const uint8_t event[] = {0x0e, 0x04, 0x01, static_cast<uint8_t>(code & 0xff),
+                             static_cast<uint8_t>(code >> 8),
+                             static_cast<uint8_t>(bluetooth::hci::ErrorCode::UNKNOWN_HCI_COMMAND)};
+    BT_HDR* response = static_cast<BT_HDR*>(osi_calloc(sizeof(BT_HDR) + sizeof(event)));
+    response->event = MSG_HC_TO_STACK_HCI_EVT;
+    response->len = sizeof(event);
+    memcpy(response->data, event, sizeof(event));
+    complete_callback(response, context);
+    return;
+  }
   LOG_DEBUG("Received cmd complete for %s",
             bluetooth::hci::OpCodeText(view.GetCommandOpCode()).c_str());
   BT_HDR* response = WrapPacketAndCopy(MSG_HC_TO_STACK_HCI_EVT, &view);
@@ -224,7 +241,7 @@ static void transmit_command(const BT_HDR* command,
     bluetooth::shim::GetHciLayer()->EnqueueCommand(
         std::move(packet),
         bluetooth::shim::GetGdShimHandler()->BindOnce(
-            OnTransmitPacketCommandComplete, complete_callback, context));
+            OnTransmitPacketCommandComplete, complete_callback, context, op_code));
     osi_free(const_cast<void*>(static_cast<const void*>(command)));
   }
 }
