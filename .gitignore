# Device backups and firmware: large, and they can hold MAC addresses, serial numbers and keys. Store them separately.
*.img
*.bin
*.fex
*.apk
*.apex
*.capex
*.zip
*.tar
*.tar.gz
*.xz
*.lz4
SHA256SUMS
backup/
backups/
stock/
device-report-*/
boot-logs-*/

# Logs can hold serial numbers, MAC addresses and email addresses. Share one on purpose if it's clean: git add -f.
*.log

# Device workspaces describe a real unit and its owner. Back them up privately.
devices/*
!devices/.gitkeep

# Secrets
adbkey
adbkey.pub
*.pem
*.pk8
.env

__pycache__/
*.pyc

# Manufacturer files must never be committed. See NOTICE.md.
*.ko
*.dtb
*.dtbo
precompiled_sepolicy
proprietary/
prebuilt/

# Timing results from tools/measure: personal measurements, not part of the toolkit.
tools/measure/*.csv
